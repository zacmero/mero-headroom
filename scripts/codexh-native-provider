#!/usr/bin/env bash
set -euo pipefail

mode="${MERO_HEADROOM_MODE:-token}"
profile=default
if [ "${1:-}" = "90%" ]; then
  profile=agent-90
  shift
elif [ "${1:-}" = "cache" ]; then
  mode="cache"
  shift
fi

if [ "$profile" = "agent-90" ]; then
  default_port=18998
elif [ "$mode" = "cache" ]; then
  default_port=18995
else
  default_port=18996
fi

port="${MERO_HEADROOM_PORT:-$default_port}"
base_url="http://127.0.0.1:${port}/v1"
log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/mero-headroom"
log_file="$log_dir/proxy-${mode}-${port}.log"
patcher="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/apply-headroom-codex-array-patch"

headroom_bin="${MERO_HEADROOM_BIN:-$HOME/.local/share/mero-headroom/runtime-0.43.1/bin/headroom}"
headroom_version="$("$headroom_bin" --version)"
interceptor_args=()
case "$headroom_version" in
  'headroom, version 0.31.0')
    "$patcher"
    interceptor_args=(--intercept-tool-results)
    ;;
  'headroom, version 0.43.1')
    # Upstream handles Codex arrays. Stable core compression does not require
    # the separately gated file-read interceptors.
    ;;
  *) printf 'Unsupported Headroom version: %s\n' "$headroom_version" >&2; exit 2 ;;
esac

proxy_ready() {
  curl -fsS --max-time 5 "http://127.0.0.1:${port}/health" >/dev/null 2>&1
}

# Serialize launchers so simultaneous tabs cannot both bind the same port.
mkdir -p "$log_dir"
exec 9>"$log_dir/launcher.lock"
flock -x 9

port_busy() {
  [ -n "$(ss -H -ltn "sport = :$port")" ]
}

if ! proxy_ready && port_busy; then
  if [ -z "${MERO_HEADROOM_PORT:-}" ] && [ "$profile" = default ] && [ "$mode" = token ]; then
    printf 'Headroom :18996 is occupied but unresponsive; using recovery port :18994. Existing clients remain on :18996.\n' >&2
    port=18994
    base_url="http://127.0.0.1:${port}/v1"
    log_file="$log_dir/proxy-${mode}-${port}.log"
  fi
  if ! proxy_ready && port_busy; then
    printf 'Headroom port :%s is occupied but unhealthy; refusing to start a competing proxy. Inspect with ss -ltnp and check %s.\n' "$port" "$log_file" >&2
    exit 1
  fi
fi

if ! proxy_ready; then
  mkdir -p "$log_dir"
  proxy_env=(
    HEADROOM_TELEMETRY=off
    HEADROOM_MODE="$mode"
    HEADROOM_CODEX_WS_COMPRESSION_TIMEOUT_SECONDS=15
    OMP_NUM_THREADS=2
    MKL_NUM_THREADS=2
    OPENBLAS_NUM_THREADS=2
    HEADROOM_KOMPRESS_ONNX_INTRA_THREADS=2
    HEADROOM_KOMPRESS_ONNX_INTER_THREADS=1
    TOKENIZERS_PARALLELISM=false
  )
  if [ "$profile" = default ]; then
    # Keep native log/JSON/code compression; avoid ML inference blocking Codex traffic.
    proxy_env+=(HEADROOM_DISABLE_KOMPRESS_OPENAI=1)
  fi
  if [ "$profile" = "agent-90" ]; then
    proxy_env+=(
      HEADROOM_SAVINGS_PROFILE=agent-90
      HEADROOM_ACCURACY_GUARD=strict
      HEADROOM_COMPRESS_SYSTEM_MESSAGES=1
      HEADROOM_COMPRESS_USER_MESSAGES=1
      HEADROOM_FORCE_KOMPRESS=1
      HEADROOM_KOMPRESS_MAX_TOKENS=4000
      HEADROOM_COMPRESSION_DEADLINE_MS=8000
      HEADROOM_TARGET_RATIO=0.10
      HEADROOM_MAX_ITEMS=8
      HEADROOM_MIN_TOKENS=120
      HEADROOM_PROTECT_ANALYSIS_CONTEXT=1
      HEADROOM_PROTECT_RECENT=2
    )
  fi
  setsid env "${proxy_env[@]}" \
    "$headroom_bin" proxy --port "$port" --mode "$mode" \
      "${interceptor_args[@]}" --code-aware \
    9>&- </dev/null >>"$log_file" 2>&1 &
  for _ in $(seq 1 30); do
    sleep 1
    proxy_ready && break
  done
fi

if ! proxy_ready; then
  printf 'Headroom proxy did not start. Log: %s\n' "$log_file" >&2
  exit 1
fi

flock -u 9
exec 9>&-

# Keep built-in provider identity. No config, session, or SQLite mutation.
exec codex \
  -c 'model_provider="openai"' \
  -c "openai_base_url=\"$base_url\"" \
  -c "mcp_servers.headroom.command=\"$headroom_bin\"" \
  -c 'mcp_servers.headroom.args=["mcp","serve"]' \
  -c "mcp_servers.headroom.env.HEADROOM_PROXY_URL=\"$base_url\"" \
  "$@"
